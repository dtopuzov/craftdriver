{
  "name": "craftdriver",
  "version": "1.4.0",
  "description": "Modern WebDriver automation library for NodeJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "craftdriver": "bin/craftdriver.mjs"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "HEADLESS=true vitest run",
    "test:firefox": "BROWSER_NAME=firefox HEADLESS=true vitest run --maxWorkers=2",
    "test:chrome": "BROWSER_NAME=chrome vitest run",
    "test:chromium": "BROWSER_NAME=chromium vitest run",
    "test:recipes": "HEADLESS=true vitest run --config vitest.recipes.config.ts",
    "test:electron": "vitest run --config vitest.electron.config.ts",
    "bench": "HEADLESS=true vitest run --config vitest.perf.config.ts",
    "clean": "rimraf dist",
    "serve": "http-server ./examples -a 127.0.0.1 -p 8080 -c-1 --cors",
    "examples:start": "npm run serve",
    "docs:examples": "node scripts/copy-examples.mjs",
    "docs:api": "node scripts/gen-api-reference.mjs",
    "docs:api:check": "node scripts/gen-api-reference.mjs --check",
    "predocs:dev": "npm run docs:examples",
    "docs:dev": "vitepress dev docs",
    "predocs:build": "npm run docs:examples",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:api:check && npm run docs:build",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "keywords": [
    "webdriver",
    "bidi",
    "firefox",
    "chrome",
    "chromium",
    "electron",
    "electron-testing",
    "desktop-app-testing",
    "automation",
    "browser-automation",
    "e2e",
    "e2e-testing",
    "testing",
    "selenium",
    "mcp",
    "cli",
    "agent",
    "ai",
    "ai-agents",
    "web-testing"
  ],
  "author": "Dimitar Topuzov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtopuzov/craftdriver.git"
  },
  "bugs": {
    "url": "https://github.com/dtopuzov/craftdriver/issues"
  },
  "homepage": "https://dtopuzov.github.io/craftdriver/",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin",
    "docs/**/*.md",
    "docs/public",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^9.8.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.5",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "axe-core": "^4.12.1",
    "ws": "^8.21.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "ip-address": "10.1.1",
    "npm": "^11.18.0",
    "undici": "7.28.0",
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
